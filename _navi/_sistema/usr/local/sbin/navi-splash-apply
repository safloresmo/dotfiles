#!/bin/bash
# Copia la animación Navi a Plymouth y la mete en el arranque.
# El vídeo original está en _navi/arranque/navi.webm.
# Una actualización de ryoku-desktop vuelve a dejar el tema ryoku;
# el hook navi-splash.hook llama a este script después y lo restaura.
set -u

src_root=/home/sfm/dotfiles/_navi/_sistema
theme_src=$src_root/usr/share/plymouth/themes/navi
hook_src=$src_root/etc/pacman.d/hooks/navi-splash.hook
apply_src=$src_root/usr/local/sbin/navi-splash-apply
theme=/usr/share/plymouth/themes/navi
stamp=/var/lib/navi/splash.stamp

[ "$(id -u)" -eq 0 ] || { echo "hace falta root" >&2; exit 1; }

if [ -d "$theme_src" ]; then
    mkdir -p "$theme"
    cp -a "$theme_src/." "$theme/"
    chown -R root:root "$theme"
    find "$theme" -type d -exec chmod 755 {} +
    find "$theme" -type f -exec chmod 644 {} +
fi
[ -f "$theme/navi.script" ] || { echo "falta el tema navi" >&2; exit 1; }

if [ -f "$hook_src" ]; then
    install -Dm644 "$hook_src" /etc/pacman.d/hooks/navi-splash.hook
fi
if [ -f "$apply_src" ]; then
    install -Dm755 "$apply_src" /usr/local/sbin/navi-splash-apply
fi

fp=$(find "$theme" -type f -exec sha256sum {} + | sort | sha256sum | cut -d' ' -f1)
cur=$(plymouth-set-default-theme 2>/dev/null || true)
if [ "$cur" = navi ] && [ -f "$stamp" ] && [ "$(cat "$stamp")" = "$fp" ]; then
    exit 0
fi

plymouth-set-default-theme navi
if command -v limine-mkinitcpio >/dev/null 2>&1; then
    limine-mkinitcpio
else
    mkinitcpio -P
fi
mkdir -p /var/lib/navi
printf '%s\n' "$fp" >"$stamp"
