global.count = 90;
global.base_w = frames[0].GetWidth();
global.base_h = frames[0].GetHeight();
global.ready_w = 0;
global.ready_h = 0;
global.sprite_w = global.base_w;
global.sprite_h = global.base_h;
global.frame_f = 0;

shown = [];
for (i = 0; i < global.count; i++)
  shown[i] = frames[i];

logo = Sprite(frames[0]);
logo.SetZ(0);
logo.SetOpacity(1);

fun ensure_layout()
  {
    w = Window.GetWidth();
    h = Window.GetHeight();
    if (w < 2 || h < 2)
      return 0;
    if (w == global.ready_w && h == global.ready_h)
      return 0;

    fit = Math.Min(w / 1920.0, h / 1080.0);
    tw = Math.Int(global.base_w * fit);
    th = Math.Int(global.base_h * fit);
    if (tw < 1) tw = 1;
    if (th < 1) th = 1;

    if (tw == global.base_w && th == global.base_h)
      {
        for (i = 0; i < global.count; i++)
          shown[i] = frames[i];
      }
    else
      {
        for (i = 0; i < global.count; i++)
          {
            img = frames[i];
            shown[i] = img.Scale(tw, th);
          }
      }

    global.sprite_w = tw;
    global.sprite_h = th;
    global.ready_w = w;
    global.ready_h = h;
    logo.SetX(w / 2.0 - tw / 2.0);
    logo.SetY(h / 2.0 - th / 2.0);
    logo.SetImage(shown[Math.Int(global.frame_f)]);
  }

fun refresh_callback()
  {
    ensure_layout();
    global.frame_f = global.frame_f + (30.0 / 50.0);
    while (global.frame_f >= global.count)
      global.frame_f = global.frame_f - global.count;
    logo.SetImage(shown[Math.Int(global.frame_f)]);
  }

Plymouth.SetRefreshFunction(refresh_callback);

prompt_sprite = Sprite();
prompt_sprite.SetOpacity(0);
prompt_sprite.SetZ(20);
entry_sprite = Sprite();
entry_sprite.SetOpacity(0);
entry_sprite.SetZ(21);
message_sprite = Sprite();
message_sprite.SetOpacity(0);
message_sprite.SetZ(22);

fun stars(n)
  {
    s = "";
    i = 0;
    while (i < n)
      {
        s = s + "*";
        i = i + 1;
      }
    return s;
  }

fun show_prompt(text, extra)
  {
    if (extra == "")
      extra = " ";
    prompt_image = Image.Text(text, 1, 1, 1);
    prompt_sprite.SetImage(prompt_image);
    prompt_sprite.SetPosition(Window.GetWidth() / 2.0 - prompt_image.GetWidth() / 2.0, Window.GetHeight() / 2.0 + global.sprite_h / 2.0 + 28, 20);
    prompt_sprite.SetOpacity(1);
    entry_image = Image.Text(extra, 1, 1, 1);
    entry_sprite.SetImage(entry_image);
    entry_sprite.SetPosition(Window.GetWidth() / 2.0 - entry_image.GetWidth() / 2.0, Window.GetHeight() / 2.0 + global.sprite_h / 2.0 + 56, 21);
    entry_sprite.SetOpacity(1);
  }

fun display_normal_callback()
  {
    prompt_sprite.SetOpacity(0);
    entry_sprite.SetOpacity(0);
  }

fun display_password_callback(prompt, bullets)
  {
    show_prompt(prompt, stars(bullets));
  }

fun display_question_callback(prompt, entry_text)
  {
    show_prompt(prompt, entry_text);
  }

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);

fun display_message_callback(text)
  {
    message_image = Image.Text(text, 1, 1, 1);
    message_sprite.SetImage(message_image);
    message_sprite.SetPosition(24, 24, 22);
    message_sprite.SetOpacity(1);
  }

fun hide_message_callback(text)
  {
    message_sprite.SetOpacity(0);
  }

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);

ensure_layout();

