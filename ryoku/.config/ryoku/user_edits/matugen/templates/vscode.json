  "semanticHighlighting": true,
  "semanticTokenColors": {
    "comment": {
      "foreground": "{{colors.outline.default.hex}}",
      "italic": true
    },
    "string": "{{colors.tertiary.default.hex}}",
    "number": "{{colors.tertiary.default.hex}}",
    "regexp": "{{colors.tertiary.default.hex}}",
    "keyword": "{{colors.primary.default.hex}}",
    "operator": "{{colors.on_surface_variant.default.hex}}",
    "namespace": "{{colors.primary_container.default.hex}}",
    "type": "{{colors.primary_container.default.hex}}",
    "class": "{{colors.primary_container.default.hex}}",
    "enum": "{{colors.tertiary.default.hex}}",
    "interface": "{{colors.primary_container.default.hex}}",
    "struct": "{{colors.primary_container.default.hex}}",
    "typeParameter": "{{colors.primary_container.default.hex}}",
    "function": "{{colors.primary.default.hex}}",
    "method": "{{colors.primary.default.hex}}",
    "macro": "{{colors.primary.default.hex}}",
    "decorator": "{{colors.error.default.hex}}",
    "variable": "{{colors.on_surface.default.hex}}",
    "parameter": "{{colors.on_surface_variant.default.hex}}",
    "property": "{{colors.on_surface_variant.default.hex}}",
    "enumMember": "{{colors.tertiary.default.hex}}",
    "*.readonly": {
      "italic": true
    }
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "{{colors.outline.default.hex}}",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string", "string.quoted"],
      "settings": {
        "foreground": "{{colors.tertiary.default.hex}}"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": {
        "foreground": "{{colors.tertiary.default.hex}}"
      }
    },
    {
      "scope": ["constant.other", "variable.other.constant", "support.constant"],
      "settings": {
        "foreground": "{{colors.tertiary.default.hex}}"
      }
    },
    {
      "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "{{colors.primary.default.hex}}"
      }
    },
    {
      "scope": ["keyword.operator", "keyword.operator.logical", "punctuation.separator"],
      "settings": {
        "foreground": "{{colors.on_surface_variant.default.hex}}"
      }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "{{colors.primary.default.hex}}"
      }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"],
      "settings": {
        "foreground": "{{colors.primary_container.default.hex}}"
      }
    },
    {
      "scope": ["variable", "variable.other", "variable.parameter", "meta.definition.variable"],
      "settings": {
        "foreground": "{{colors.on_surface.default.hex}}"
      }
    },
    {
      "scope": ["variable.other.property", "variable.other.member", "support.variable.property", "meta.object-literal.key"],
      "settings": {
        "foreground": "{{colors.on_surface_variant.default.hex}}"
      }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "{{colors.error.default.hex}}"
      }
    },
    {
      "scope": ["entity.other.attribute-name", "meta.attribute"],
      "settings": {
        "foreground": "{{colors.tertiary.default.hex}}"
      }
    },
    {
      "scope": ["punctuation", "meta.brace", "punctuation.definition"],
      "settings": {
        "foreground": "{{colors.on_surface_variant.default.hex}}"
      }
    },
    {
      "scope": ["invalid", "invalid.illegal", "token.error-token"],
      "settings": {
        "foreground": "{{colors.error.default.hex}}"
      }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "{{colors.primary.default.hex}}",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "{{colors.on_surface.default.hex}}",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "{{colors.on_surface.default.hex}}",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": {
        "foreground": "{{colors.tertiary.default.hex}}"
      }
    },
    {
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "{{colors.tertiary.default.hex}}"
      }
    },
    {
      "scope": ["string.regexp", "constant.other.character-class.regexp"],
      "settings": {
        "foreground": "{{colors.tertiary.default.hex}}"
      }
    },
    {
      "scope": ["comment.block.documentation", "storage.type.class.jsdoc", "punctuation.definition.block.tag.jsdoc"],
      "settings": {
        "foreground": "{{colors.outline.default.hex}}",
        "fontStyle": "italic"
      }
    }
  ]
}
