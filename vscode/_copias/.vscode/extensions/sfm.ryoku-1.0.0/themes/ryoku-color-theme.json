  "semanticHighlighting": true,
  "semanticTokenColors": {
    "comment": {
      "foreground": "#909090",
      "italic": true
    },
    "string": "#c7c7c7",
    "number": "#c7c7c7",
    "regexp": "#c7c7c7",
    "keyword": "#c6c6c6",
    "operator": "#c6c6c6",
    "namespace": "#474747",
    "type": "#474747",
    "class": "#474747",
    "enum": "#c7c7c7",
    "interface": "#474747",
    "struct": "#474747",
    "typeParameter": "#474747",
    "function": "#c6c6c6",
    "method": "#c6c6c6",
    "macro": "#c6c6c6",
    "decorator": "#c7c7c7",
    "variable": "#e2e2e2",
    "parameter": "#c6c6c6",
    "property": "#c6c6c6",
    "enumMember": "#c7c7c7",
    "*.readonly": {
      "italic": true
    }
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#909090",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string", "string.quoted"],
      "settings": {
        "foreground": "#c7c7c7"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": {
        "foreground": "#c7c7c7"
      }
    },
    {
      "scope": ["constant.other", "variable.other.constant", "support.constant"],
      "settings": {
        "foreground": "#c7c7c7"
      }
    },
    {
      "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#c6c6c6"
      }
    },
    {
      "scope": ["keyword.operator", "keyword.operator.logical", "punctuation.separator"],
      "settings": {
        "foreground": "#c6c6c6"
      }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#c6c6c6"
      }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"],
      "settings": {
        "foreground": "#474747"
      }
    },
    {
      "scope": ["variable", "variable.other", "variable.parameter", "meta.definition.variable"],
      "settings": {
        "foreground": "#e2e2e2"
      }
    },
    {
      "scope": ["variable.other.property", "variable.other.member", "support.variable.property", "meta.object-literal.key"],
      "settings": {
        "foreground": "#c6c6c6"
      }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#c7c7c7"
      }
    },
    {
      "scope": ["entity.other.attribute-name", "meta.attribute"],
      "settings": {
        "foreground": "#c7c7c7"
      }
    },
    {
      "scope": ["punctuation", "meta.brace", "punctuation.definition"],
      "settings": {
        "foreground": "#c6c6c6"
      }
    },
    {
      "scope": ["invalid", "invalid.illegal", "token.error-token"],
      "settings": {
        "foreground": "#c7c7c7"
      }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#c6c6c6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#e2e2e2",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#e2e2e2",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": {
        "foreground": "#c7c7c7"
      }
    },
    {
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "#c7c7c7"
      }
    },
    {
      "scope": ["string.regexp", "constant.other.character-class.regexp"],
      "settings": {
        "foreground": "#c7c7c7"
      }
    },
    {
      "scope": ["comment.block.documentation", "storage.type.class.jsdoc", "punctuation.definition.block.tag.jsdoc"],
      "settings": {
        "foreground": "#909090",
        "fontStyle": "italic"
      }
    }
  ]
}
